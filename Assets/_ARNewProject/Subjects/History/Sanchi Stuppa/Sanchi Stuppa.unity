  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: Who originally commissioned the Great Stupa at Sanchi in the 3rd
      century BCE?
    options:
    - Emperor Ashoka
    - Emperor Akbar
    - Chandragupta II
    - Emperor Shah Jahan
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: d3eb05502b2a1c248ae038ed3d7c6cdf, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 051ca1fdccacbf849948ceff0b34dd7b, type: 3}
  - questionText: What is the large hemispherical dome of the Sanchi Stupa called?
    options:
    - Anda
    - Harmika
    - Vedika
    - Torana
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 153b05ebacfb9df45b7e32df7d559a81, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 585b06aac6e6f6849aefb4cd4cfa8242, type: 3}
  - questionText: How many major Toranas, or gateways, surround the Great Stupa at
      Sanchi?
    options:
    - Three gateways
    - Four gateways
    - Six gateways
    - Two gateways
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: e45baf683e388c046abd1550a2dff927, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: c9d7fbda4f0afa64f9120774d41b74ad, type: 3}
  - questionText: Which feature is the small square enclosure located above the Anda?
