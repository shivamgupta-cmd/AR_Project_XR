  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Royal Symbols are objects, signs, and emblems that represent power, authority,
    leadership, courage, protection, and royal heritage. Throughout history, rulers
    used these symbols to show their position and connection with the kingdom.

    The
    Crown is one of the most recognizable symbols of royalty. It represents authority,
    dignity, leadership, and the position of a king or queen. Crowns are often decorated
    with precious stones and elaborate designs to express wealth and importance.

    The
    Royal Throne represents the seat of power. Kings and queens traditionally sat
    on thrones during important ceremonies and official occasions. The throne symbolizes
    authority, leadership, and responsibility toward the kingdom and its people.

    The
    Scepter is a ceremonial staff carried by rulers. It represents royal authority
    and the power to govern. Its detailed design often reflects the wealth, traditions,
    and identity of a royal kingdom.

    The Royal Orb represents the world and
    the ruler''s responsibility over the kingdom. Together with the crown and scepter,
    it has traditionally been used as an important symbol of royal authority.

    The
    Shield represents protection, strength, and courage. Shields were historically
    associated with warriors and were often decorated with symbols representing a
    family, kingdom, or royal house.

    The Lion is a powerful symbol of bravery,
    strength, courage, and leadership. Because of its strength and majestic appearance,
    the lion has been associated with rulers and royal families in many cultures.

    In
    this 3D learning experience, students can explore each royal symbol from different
    angles. They can rotate and zoom in on the models to observe their shapes, decorations,
    and details. The Info section provides additional knowledge about the meaning
    and significance of each symbol, while the Quiz section allows students to test
    what they have learned.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 956b217cc7cf8c3428c64cf5f91c13b5, type: 2}
  m_sharedMaterial: {fileID: -7116138974986501691, guid: 956b217cc7cf8c3428c64cf5f91c13b5, type: 2}
