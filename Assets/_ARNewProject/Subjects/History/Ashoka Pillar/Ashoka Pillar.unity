  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: 'Which famous Ashoka Pillar capital became the State Emblem of
      India? '
    options:
    - Elephant Capital of Dhauli
    - 'Lion Capital of Sarnath '
    - Bull Capital of Rampurva
    - 'Horse Capital of Sanchi '
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 09ba0c9985771b04ab35455ccc4af9f1, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: f6c04211a645c5348bb9eb0f0d4c3613, type: 3}
  - questionText: What does the Dharma Chakra primarily represent in the Ashoka Pillar
      symbolism?
    options:
    - 'The four seasons of India '
    - 'The construction of ancient roads '
    - 'The expansion of the Mauryan army '
    - 'The cycle of Dharma and righteous living '
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: b2eeb9234917bc548965010eabec2167, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 553d912da28fe314fbdd42984a2c835e, type: 3}
  - questionText: 'Which major structural part supports the Lion Capital and sits
      above the shaft? '
    options:
    - 'Foundation trench '
    - Torana
    - Abacus
    - 'Pradakshina path '
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: c7ce74aa8c1fa6f47923261477379713, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 999fb6fd84fd69444896cf5d10295f47, type: 3}
  - questionText: 'How are the four lions of the Sarnath Lion Capital positioned? '
    options:
    - Facing downward toward the base
    - 'Facing each other in pairs '
    - Standing in a single straight line
    - Standing back to back
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: 852b1d4f65c43e144bea8041eb6b3c15, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 5eb930929cd69e34ba2d912169bf2591, type: 3}
