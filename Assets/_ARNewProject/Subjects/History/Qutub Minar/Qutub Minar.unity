  questions:
  - questionText: 'Approximately how tall is Qutub Minar? '
    options:
    - 72.5 metres
    - 52.5 metres
    - 62.5 metres
    - '82.5 metres '
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 65e9dae61a4cce843bd61bc97c3b0e25, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 7c02fdd64660aa74f8cf12ec48802930, type: 3}
  - questionText: 'How many storeys does the present Qutub Minar have? '
    options:
    - 'Four storeys '
    - 'Three storeys '
    - Six storeys
    - Five storeys
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: 01ae0b2a4fc732847b81f12220e0976d, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: d10eabbe39cfb924694319c10ead6c2b, type: 3}
  - questionText: 'Under whose rule did construction of Qutub Minar begin in 1199
      CE? '
    options:
    - Akbar
    - Qutb-ud-din Aibak
    - Shah Jahan
    - Aurangzeb
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 70a1aebe8498b7f46aca313764f8af18, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd28e348501b96241958273fda3264e7, type: 3}
  - questionText: What architectural feature separates the major storeys of Qutub
      Minar?
