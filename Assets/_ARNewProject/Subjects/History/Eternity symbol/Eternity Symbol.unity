  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: "What does the \u221E symbol commonly represent?"
    options:
    - A fixed point
    - A straight line
    - Infinity and endlessness
    - A beginning and an end
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: fa69b9db23a79a54c8d9e815ba4cfcad, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 0c6a6197d5f4da8419f552b31d5ba8e7, type: 3}
  - questionText: What is special about the path of the infinity symbol?
    options:
    - It has a fixed endpoint
    - It forms two continuous loops
    - It is always a straight line
    - It has only one direction
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 433655b0c0833834086d1c70638de346, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 28d2e0ce108f9f945a5ddf13699f8a73, type: 3}
  - questionText: What does the central intersection represent?
    options:
    - Separation
    - 'Connection '
    - A starting point
    - A stopping point
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 1937898c77835f7458707ec415ad913f, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 8a8709c51de833143b61640e160e3cac, type: 3}
