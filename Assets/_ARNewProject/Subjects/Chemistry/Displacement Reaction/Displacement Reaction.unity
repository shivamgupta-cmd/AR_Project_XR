  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A displacement reaction occurs when a more reactive element replaces a
    less reactive element from its compound. When iron is placed in copper sulfate
    solution, iron displaces copper and forms iron sulfate while copper is deposited
    on the iron surface. The reaction is Fe + CuSO4 \u2192 FeSO4 + Cu. This happens
    because iron is more reactive than copper."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
