  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What happens in a displacement reaction?
    options:
    - A more reactive element replaces a less reactive element from its compound
    - One compound breaks into simpler substances
    - Two compounds combine to form one substance
    - A substance changes only its physical state
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What happens when an iron nail is placed in copper sulfate solution?
    options:
    - Iron displaces copper from copper sulfate
    - Copper displaces iron from the nail
    - No reaction occurs
    - Iron changes into copper
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What substance is deposited on the iron nail during the reaction?
    options:
    - Copper
    - Iron sulfate
    - Sulfur
    - Oxygen
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Which products are formed when iron reacts with copper sulfate?
    options:
    - Iron sulfate and copper
    - Iron oxide and copper
    - Copper sulfate and iron oxide
    - Iron and sulfur dioxide
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
