  m_Script: {fileID: 11500000, guid: 3d893381e1202214b86f97987eddbf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: According to Bohr's model, where do electrons move around the nucleus?
    options:
    - In fixed energy levels or shells
    - Randomly throughout the atom
    - Inside the nucleus
    - Only on the surface of the atom
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What happens when an electron absorbs energy in the Bohr model?
    options:
    - It moves to a higher energy level
    - It enters the nucleus
    - It loses its negative charge
    - It becomes a proton
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What happens when an excited electron returns to a lower energy
      level?
    options:
    - It releases energy as light
    - It absorbs more energy
    - The nucleus breaks apart
    - The electron disappears
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What is located at the center of the Bohr atomic model?
    options:
    - A small positively charged nucleus
    - A negatively charged sphere
    - Only electrons
    - An empty region
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
