  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What happens to an electron when sodium forms an ionic bond with
      chlorine?
    options:
    - It is transferred from sodium to chlorine
    - It is transferred from chlorine to sodium
    - It remains shared equally
    - It enters the sodium nucleus
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What charge does sodium have after losing one electron?
    options:
    - Negative
    - Positive
    - Neutral
    - No electric charge
    correctAnswerIndex: 1
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Why do sodium and chloride ions attract each other?
    options:
    - They have the same charge
    - They share a nucleus
    - They have opposite charges
    - They have no electrons
    correctAnswerIndex: 2
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What structure is formed by many sodium and chloride ions?
    options:
    - A single atom
    - A covalent molecule
    - A gas cloud
    - A repeating crystal lattice
    correctAnswerIndex: 3
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
