  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What happens to copper(II) oxide during the redox reaction with
      hydrogen?
    options:
    - It is reduced to copper
    - It is oxidized to copper
    - It changes into hydrogen
    - It remains unchanged
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Why is hydrogen oxidized in this reaction?
    options:
    - It combines with oxygen to form water
    - It loses oxygen to form copper
    - It changes directly into copper
    - It removes hydrogen from water
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What are the products of the reaction between copper(II) oxide
      and hydrogen?
    options:
    - Copper and water
    - Copper oxide and water
    - Hydrogen and copper oxide
    - Copper and oxygen
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Which equation represents this redox reaction?
    options:
    - "CuO + H2 \u2192 Cu + H2O"
    - "Cu + H2O \u2192 CuO + H2"
    - "CuO + O2 \u2192 Cu + H2O"
    - "Cu + H2 \u2192 CuO"
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
