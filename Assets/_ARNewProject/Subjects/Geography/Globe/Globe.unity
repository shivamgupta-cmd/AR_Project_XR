  questions:
  - questionText: Which end of a compass needle points toward Magnetic North?
    options:
    - The red or marked end
    - The white end
    - The east end
    - The south end
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Why does a compass needle align in a north-south direction?
    options:
    - Because sunlight pulls the needle
    - Because Earth's magnetic field influences the needle
    - Because the compass dial rotates automatically
    - Because gravity points toward North
    correctAnswerIndex: 1
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Which set contains the four cardinal directions?
    options:
    - North, Northeast, South, Southwest
    - Northeast, Southeast, Southwest, Northwest
    - North, East, South, West
    - Up, Down, Left, Right
    correctAnswerIndex: 2
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
