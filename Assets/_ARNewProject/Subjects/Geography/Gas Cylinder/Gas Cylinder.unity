  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: How was positive charge distributed in Thomson's atomic model?
    options:
    - Uniformly throughout the atom
    - Only inside a central nucleus
    - Only around the outer surface
    - In fixed energy levels
    correctAnswerIndex: 0
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Where were electrons located in Thomson's atomic model?
    options:
    - Inside a central nucleus
    - Embedded within the positive sphere
    - Moving in fixed energy levels
    - Outside the atom
    correctAnswerIndex: 1
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: What was absent from Thomson's atomic model?
    options:
    - Positive charge
    - Electrons
    - A central nucleus
    - Negative charge
    correctAnswerIndex: 2
    questionVoice: {fileID: 0}
    correctAnswerVoice: {fileID: 0}
  - questionText: Why was the atom electrically neutral in Thomson's model?
    options:
    - The atom contained no charges
    - Only positive charges were present
    - Electrons had no electric charge
    - The total positive and negative charges balanced each other
    correctAnswerIndex: 3
