  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "An electric cell converts chemical energy into electrical energy. It has
    a positive terminal and a negative terminal. When the cell is connected to a
    suitable bulb through wires and a closed switch, the circuit has a complete conducting
    path and the bulb can light. Opening the switch breaks that path. [1, 4]\r\nThis
    module shows a simplified zinc-carbon dry cell. Its zinc container is the negative
    electrode. The manganese-dioxide mixture is the active positive-side material,
    and the carbon rod provides a conducting connection to the positive terminal.
    The electrolyte allows ions to move inside the cell, while a separator keeps
    the solid materials apart. [1\u20133]\r\nThe example cell is rated at a nominal
    1.5 volts. Two matching cells connected positive-to-negative in series have a
    combined nominal voltage of 3.0 volts. Real output and bulb brightness depend
    on the cells and the connected device. Use cells safely and follow the device
    instructions. [5\u20137]\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
