  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: Which energy conversion takes place when an electric cell supplies
      a circuit?
    options:
    - Electrical energy to sound energy
    - Chemical energy to electrical energy
    - Light energy to chemical energy
    - Heat energy to light energy
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: aa44c6c1bf5d7bf498737b6cf4890c03, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: Which terminal is marked with a plus (+) sign?
    options:
    - Negative terminal
    - Both terminals
    - Positive terminal
    - Neither terminal
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 0a62e029b359a4f4f8e9af05ce9ffd0c, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What is the main function of an electric cell?
    options:
    - To produce light
    - To convert chemical energy into electrical energy
    - To store sound energy
    - To produce heat only
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 43cb04217b1f9f24fa59571ada43686f, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
