  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "An animal cell is the basic structural and functional unit of an animal\u2019s
    body. Animal cells contain several specialized parts called organelles, and each
    organelle performs a particular job. Together, these parts help the cell grow,
    produce energy, transport materials, and carry out important activities.\nThe
    cell membrane forms the outer boundary of the cell. It protects the cell and
    controls which substances enter and leave. Inside the cell is the cytoplasm,
    a jelly-like substance that holds the organelles and is the site of many chemical
    reactions.\nThe nucleus acts as the control center of the cell. It contains DNA,
    which carries instructions for the cell\u2019s growth and activities. Inside
    the nucleus, the nucleolus helps produce ribosomes needed for making proteins.\nThe
    endoplasmic reticulum is a network of membranes that helps make and transport
    proteins and other materials. These materials can then be processed by the Golgi
    apparatus, which modifies, sorts, packages, and sends them to where they are
    needed.\nMitochondria release usable energy from food, providing energy for different
    cell activities. Centrioles also play an important role by helping organize structures
    involved in cell division.\nAlthough each organelle has a different function,
    they work together as a coordinated system to keep the animal cell alive and
    functioning properly."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ecf77945acdc26144b2f70e021c9fd31, type: 2}
