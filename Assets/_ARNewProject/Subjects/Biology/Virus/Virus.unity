  questions:
  - questionText: Why does a virus need a host cell?
    options:
    - To produce sunlight
    - To make new viruses
    - To produce water
    - To make food
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 1e87c7d46b3dab945abd68286e794752, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What genetic material can viruses contain?
    options:
    - Only DNA
    - Only RNA
    - DNA or RNA
    - Glucose
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 820eaa13d46e2d64d9458543722bee5e, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What happens after new virus particles are formed?
