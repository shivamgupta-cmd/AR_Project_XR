  m_Script: {fileID: 11500000, guid: 3d893381e1202214b86f97987eddbf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: Why is a convex lens called a converging lens?
    options:
    - It reflects all light rays
    - It brings parallel light rays together
    - It separates white light only
    - It blocks light rays
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 99d1a902d5102444c932647c05959437, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What type of image is formed when an object is placed beyond twice
      the focal length of a convex lens?
    options:
    - Virtual, upright, and magnified
    - Real, upright, and diminished
    - Real, inverted, and diminished
    - Virtual, inverted, and enlarged
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 6418f9db59b927a4d8b67f35d67fc5a9, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What type of image is formed when an object is placed at twice
      the focal length of a convex lens?
    options:
    - Real, inverted, and the same size
    - Virtual, upright, and magnified
    - Real, upright, and enlarged
    - Virtual, inverted, and diminished
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: d32cfac563a97c942a407686e62a6665, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What image does a convex lens form when the object is between the
      focal point and the optical centre?
    options:
    - Real, inverted, and diminished
    - Real, inverted, and magnified
    - Virtual, upright, and magnified
    - Virtual, upright, and diminished
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 997a8262f1d95e34b9c552f180c1e16c, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: Which device commonly uses a convex lens to produce a magnified
      image?
    options:
    - Plane mirror
    - Magnifying glass
    - Periscope
    - Kaleidoscope
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: e632e1ce212f5dc4584b20818de05ac8, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
