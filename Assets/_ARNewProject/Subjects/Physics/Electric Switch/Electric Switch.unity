  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What happens to a simple circuit when an electric switch is turned
      ON?
    options:
    - 'The circuit becomes closed '
    - 'The circuit becomes open '
    - 'The battery is disconnected permanently '
    - The wires stop conducting
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 4be909435c154124e8e783d3c7dcb673, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 5c1e6e3e3a189d949b998560329d0d40, type: 3}
  - questionText: What happens to the bulb in a simple battery-switch-bulb circuit
      when the switch is turned OFF?
    options:
    - 'The bulb continues receiving current through the open gap '
    - The bulb turns off
    - The bulb changes into a battery
    - 'The bulb becomes brighter '
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 20376ccabe9bbf94b9ce1c74c029c94c, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 10f83e2138ac38646ab9e9cd9bdba825, type: 3}
  - questionText: What is the main purpose of an electric switch in a simple circuit?
    options:
    - To control the flow of current
    - To increase the battery voltage
    - 'To store electrical energy '
    - To generate electrical energy
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: c2e669f164dc42c43868b4f1222558ff, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 6e522ca29b5917645ad4b4bd08a23f9d, type: 3}
