--- !u!114 &6202221520409339419
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2193194492938644036}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d893381e1202214b86f97987eddbf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: An object moves around a circular path at constant speed. Which
      quantity continuously changes because the direction of motion changes?
    options:
    - Radius
    - Velocity
    - Object size
    - Mass
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: fc3d653cdfeff554ca5d888114c9a2d2, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: e3d3588e25203fb49ba49d905f9cde77, type: 3}
  - questionText: A ball moves in a circle with constant speed. If its speed is increased
      while the radius stays the same, what happens to centripetal acceleration?
    options:
    - It becomes independent of speed
    - It decreases
    - It remains zero
    - It increases
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: 199b8fee1ace6374b91f32620a8b3192, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: b65c3aa2a1d7f6a4bac224759575c085, type: 3}
  - questionText: A circular-motion experiment keeps speed and mass constant but
      increases the radius of the circular path. What happens to the required centripetal
      force?
    options:
    - It increases
    - It stays exactly the same
    - It becomes zero
    - It decreases
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: 0d924bfca83a6504884653012c221aeb, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: f0d73898af39b3a4481e860f959fa534, type: 3}
  m_quizPanel: {fileID: 7019613817051215216}
  m_gameOverPanel: {fileID: 4707464959079549715}
