  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Circular motion is the motion of an object along a circular path. The
    object may move with constant speed, but its velocity changes because velocity
    includes both speed and direction. Since the direction continuously changes,
    the object experiences acceleration directed toward the centre of the circular
    path. This acceleration is called centripetal acceleration.\n\nThe magnitude
    of centripetal acceleration is given by a\u1D9C = v\xB2/r, where v is the object's
    speed and r is the radius of the circular path. The force required to maintain
    circular motion is called centripetal force, given by F\u1D9C = mv\xB2/r, where
    m represents mass.\n\nIf the speed increases, centripetal acceleration and centripetal
    force increase significantly because speed is squared. If the radius increases
    while speed remains constant, centripetal acceleration and force decrease. Increasing
    the mass does not change centripetal acceleration for the same speed and radius,
    but it increases the required centripetal force.\n\nCircular motion can be observed
    in many situations, including cars turning around curves, rotating wheels, objects
    moving on a string, satellites orbiting Earth, and planets orbiting the Sun."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
