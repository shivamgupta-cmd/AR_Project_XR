  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ohm\u2019s Law describes the relationship between voltage, current, and
    resistance in an electrical circuit. For a resistor that obeys this law, current
    is directly proportional to the voltage across it, provided the temperature and
    other physical conditions remain constant.\n\nV = I \xD7 R\n\nV represents voltage,
    measured in volts (V).\nI represents current, measured in amperes (A).\nR represents
    resistance, measured in ohms (\u03A9).\n\nThe DC voltage source provides the
    potential difference that drives current around a closed circuit. The resistor
    limits current without using up electric charge. The switch opens or closes the
    circuit.\n\nAn ammeter measures current and is connected in series. A voltmeter
    measures the voltage across the resistor and is connected in parallel.\n\nIn
    this module, the resistance is fixed at 6 \u03A9. At 6 V, the current is 1 A.
    Increasing the voltage to 12 V increases the current to 2 A. Doubling the voltage
    doubles the current because resistance remains unchanged.\n\nUse the slider to
    adjust the voltage from 2 V to 12 V and observe the meter readings. The current-versus-voltage
    graph forms a straight line through the origin, showing their directly proportional
    relationship."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
