  questions:
  - questionText: "A resistor has 9 V across it and a resistance of 3 \u03A9. What
      is the current?"
    options:
    - 1A
    - 3A
    - 6A
    - 27A
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: ab4227551f8baea4eb7874d25bdc2654, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: At constant voltage, what happens to the current if resistance
      doubles?
    options:
    - It doubles
    - It stays the same
    - It becomes zero
    - It becomes half
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: 2e50013866477f94296188601ecadbba, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: Which instrument is connected in parallel across the resistor to
      measure voltage?
    options:
    - Voltmeter
    - Ammeter
    - Switch
    - Battery
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 91fadd99efd801b4bb2729da8dc32597, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
