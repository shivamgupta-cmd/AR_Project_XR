  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What is the process called when white light splits into different
      colours after passing through a prism?
    options:
    - Reflection
    - Dispersion
    - Absorption
    - Diffraction
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 3117e5330ea191f4c8857241166f083e, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: Which colour of visible light bends the least when passing through
      a glass prism?
    options:
    - Violet
    - Blue
    - Red
    - Green
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 5fd1c7b91651cd340978e24ffe9a0bbd, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: Which formula represents the refractive index of a material?
    options:
    - n = c / v
    - n = v / c
    - "n = c \xD7 v"
    - n = c + v
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 62e87554281b34d47b4b444ff2d69536, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
