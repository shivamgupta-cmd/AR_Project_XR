  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: What happens when electric current flows through the copper coil?
    options:
    - The battery becomes magnetic
    - A magnetic field is created
    - The switch stops working
    - The iron core melts
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 4c04a6e8c45b2ae49a26340f50f76251, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What is the purpose of the iron core in an electromagnet?
    options:
    - To stop the current
    - To reduce the magnetic field
    - To strengthen the magnetic field
    - To disconnect the battery
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 913656d71b5795c4cacf694c01cd2815, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
  - questionText: What happens when the switch is turned off?
    options:
    - The magnetic field becomes stronger
    - The current increases
    - The magnetic effect disappears
    - The battery becomes an electromagnet
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 3dc6a4c14b99b6f4dbca683cc201d3ca, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: cd01db94c85f0eb409db86289b23b4ae, type: 3}
